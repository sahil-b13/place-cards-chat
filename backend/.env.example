# Copy to .env and fill in. Never commit .env. Never paste keys in chat.
MOCK_MODE=true
# Mock vision fixture: empty = cycle leopold,gateway,ambiguous,generic by photo order.
# One name (leopold|gateway|ambiguous|generic) = every photo; comma list = per photo order.
MOCK_SCENARIO=

# Live vision provider: gemini (default, free tier available) or anthropic
VISION_PROVIDER=gemini
GEMINI_API_KEY=
# Check Google's current model list before relying on this default
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-5-5

GOOGLE_PLACES_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173
CACHE_TTL_SECONDS=86400

# Phase 7: hardening / hosting
RATE_LIMIT_PER_MINUTE=20     # POST /api/* per client IP (0 disables)
TRUST_PROXY=false            # set true on Render/Railway/Fly so the real client IP is used for rate limiting
LOG_LEVEL=INFO
