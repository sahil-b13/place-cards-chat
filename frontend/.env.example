# Copy to .env (git-ignored). Never commit real values.
# Dashboard -> Your App -> Credentials at https://app.cometchat.com
VITE_COMETCHAT_APP_ID=
VITE_COMETCHAT_AUTH_KEY=
VITE_COMETCHAT_REGION=us

# Backend from Phase 1
VITE_API_BASE_URL=http://127.0.0.1:8000

# Phase 4 fallback (default false): send place info as one formatted TEXT message instead of the card bubble
VITE_FALLBACK_TEXT_CARDS=false
